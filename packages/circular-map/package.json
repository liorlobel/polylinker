{
  "name": "@polylinker/circular-map",
  "version": "0.1.0",
  "description": "Framework-agnostic plasmid map renderer. Pure functions in, SVG string out. No DOM, no React, no runtime dependencies.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE", "LICENSE-MIT"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "keywords": [
    "plasmid", "svg", "sequence", "annotation", "molecular-biology",
    "genbank", "vector-map", "synthetic-biology"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/liorlobel/polylinker",
    "directory": "packages/circular-map"
  },
  "engines": { "node": ">=18" },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
