#!/bin/sh
# Reject the pLannotate snapgene.csv payload, whatever it has been renamed to.
#
# features/SOURCING.md section 0.4 requires both halves of this: the filename in
# .gitignore, AND a hook keyed on the content hash. The filename alone is not a
# control, because the taint gate's whole job is to bring those bytes onto the
# machine and a rename defeats a name-based rule. That file has no licence of
# any kind and no byte of it may ever be committed.
#
# Install: git config core.hooksPath tools/hooks
#
# CI compares against the same PINNED digest, but over a different set of
# bytes, and this line used to say otherwise: it claimed CI "runs the same
# comparison over the staged tree", and nothing in .github/workflows/ci.yml
# hashed any blob against PINNED at all. What CI now does, in the step
# "Nothing from the taint gate survived", is sweep the WORKING TREE after the
# taint gate has run -- every file, tracked or not, ignored or not, outside
# target/ -- and refuse the pinned digest there. A runner has no index to
# stage into, so the staged-tree half is this hook's alone and is the only
# thing standing between the payload and the history.

PINNED=793631d9eebf721efae9e1d6cd483b1cbb62f5adad41174afa8f8b78b1342d5c
status=0

for path in $(git diff --cached --name-only --diff-filter=ACMR); do
    [ -f "$path" ] || continue
    got=$(git show ":$path" | sha256sum | cut -d' ' -f1)
    if [ "$got" = "$PINNED" ]; then
        echo "refusing to commit $path: its contents are pLannotate's snapgene.csv"
        echo "(sha256 $PINNED). That file is unlicensed and is fetched transiently"
        echo "by features/build/taint_gate.py for comparison only -- see"
        echo "features/SOURCING.md section 0.4. Delete it and re-stage."
        status=1
    fi
done

exit $status
